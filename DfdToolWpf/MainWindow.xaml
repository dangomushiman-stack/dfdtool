<Window x:Class="DfdToolWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MVVM版 DFDエディタ" Height="600" Width="1100" KeyDown="Window_KeyDown" UseLayoutRounding="True">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F7F7F7">
            <MenuItem Header="ファイル">
                <MenuItem Header="📄 新規作成" Click="BtnNew_Click" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="💾 上書き保存" Click="BtnOverwriteSave_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="💾 名前を付けて保存" Click="BtnSave_Click" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="📂 読込" Click="BtnLoad_Click" />
                <Separator />
                <MenuItem Header="🖼️ 画像出力" Click="BtnExportImage_Click" />
            </MenuItem>
            <MenuItem Header="編集">
                <MenuItem Header="↶ 戻す" Click="BtnUndo_Click" IsEnabled="{Binding CanUndo}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="↷ やり直し" Click="BtnRedo_Click" IsEnabled="{Binding CanRedo}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="🗑️ 削除" Click="BtnDelete_Click" />
                <Separator />
                <MenuItem Header="🖼️ 画像を貼り付け" Click="MenuItem_PasteImage_Click" InputGestureText="Ctrl+V" />
                <MenuItem Header="🖼️ 画像ファイルを挿入" Click="MenuItem_InsertImageFile_Click" />
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="グリッド表示"
                          IsCheckable="True"
                          IsChecked="{Binding IsGridVisible, Mode=TwoWay}" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#EEE" Height="40">
            <RadioButton Content="範囲選択" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Select" Background="#F5F5F5" />
            <RadioButton Content="プロセス" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Process" IsChecked="True" />
            <RadioButton Content="実体" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Entity" />
            <Rectangle Width="2" Fill="DarkGray" Margin="5"/>
            <RadioButton Content="接続枠" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="ConnectableFrame" Background="#E2F0FF" />
            <RadioButton Content="分類枠" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="CategoryFrame" Background="#E0FFE0" />
            <Rectangle Width="2" Fill="DarkGray" Margin="5"/>
            <RadioButton Content="データストア" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="DataStore" />
            <RadioButton Content="DB" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Database" />
            <RadioButton Content="横DB" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="HorizontalDatabase" />
            <RadioButton Content="文書" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Document" />
            <RadioButton Content="付箋" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="StickyNote" Background="#FFF4A8" />
            <RadioButton Content="吹出付箋" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="StickySpeechBubble" Background="#FFF4A8" />
            <Rectangle Width="2" Fill="DarkGray" Margin="5"/>
            <RadioButton Content="↗️ 矢印" Style="{StaticResource {x:Type ToggleButton}}" GroupName="ToolMode" Margin="5" Padding="10,0" Click="BtnMode_Click" Tag="Arrow" Background="#DDF" />
            <Rectangle Width="2" Fill="DarkGray" Margin="5"/>
            <CheckBox Content="グリッドスナップ" IsChecked="{Binding SnapToGrid}" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
        </StackPanel>

        <!-- Excelのシートタブのように、同じJSONファイル内で複数の図を切り替えるためのバー -->
        <DockPanel DockPanel.Dock="Top" Background="#F5F5F5" Height="34" LastChildFill="True">
            <Button Content="＋ シート" Width="80" Margin="4,3" Padding="6,0" Click="BtnAddSheet_Click" />
            <Button Content="－ 削除" Width="70" Margin="0,3,4,3" Padding="6,0" Click="BtnDeleteSheet_Click" IsEnabled="{Binding CanDeleteSheet}" />
            <Button Content="JSON取込" Width="86" Margin="0,3,6,3" Padding="6,0" Click="BtnImportJsonAsSheet_Click" ToolTip="別のDFD JSONを現在のファイルのシートとして追加します" />

            <TabControl x:Name="SheetTabs"
                        ItemsSource="{Binding Sheets}"
                        SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                        SelectionChanged="SheetTabs_SelectionChanged"
                        Background="#F5F5F5"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter Property="Background" Value="#FFFFA500" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="70" MaxWidth="180">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                            <Setter Property="Background" Value="#FFFFA500" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <!-- 通常時：クリックでシート切替、ダブルクリックでシート名編集 -->
                            <TextBlock Text="{Binding Name}"
                                       Padding="8,3"
                                       VerticalAlignment="Center"
                                       MouseLeftButtonDown="SheetNameTextBlock_MouseLeftButtonDown"
                                       ToolTip="クリックで切替、ダブルクリックで名前変更">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNameEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 編集時だけ表示。通常クリックでは表示しない -->
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     MinWidth="70"
                                     MaxWidth="180"
                                     Padding="6,1"
                                     BorderThickness="1"
                                     Background="White"
                                     PreviewKeyDown="SheetNameTextBox_PreviewKeyDown"
                                     LostFocus="SheetNameTextBox_LostFocus"
                                     IsVisibleChanged="SheetNameTextBox_IsVisibleChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNameEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Height="0" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>

        <Grid x:Name="ViewportContainer" ClipToBounds="True">
            <Canvas x:Name="MainCanvas" Focusable="True" Background="Transparent" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MainScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="MainTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Rectangle Canvas.Left="-50000" Canvas.Top="-50000" Width="100000" Height="100000" Panel.ZIndex="-100">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="White">
                                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="20,0"/><LineGeometry StartPoint="0,0" EndPoint="0,20"/></GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen><Pen Brush="#E5E5E5" Thickness="1"/></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle x:Name="RangeSelectionRectangle"
                           Visibility="Collapsed"
                           Stroke="#4A90E2"
                           StrokeThickness="1"
                           StrokeDashArray="4 2"
                           Fill="#334A90E2"
                           IsHitTestVisible="False"
                           Panel.ZIndex="2000" />

                <ItemsControl ItemsSource="{Binding Connections}" Panel.ZIndex="10">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                                <Canvas.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="文字列表示"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding IsTextVisible, Mode=OneWay}"
                                                  Click="MenuItem_ConnectionToggleTextVisibility_Click"/>
                                        <Separator/>
                                        <MenuItem Header="矢印を実線にする" Click="MenuItem_ConnectionSolid_Click"/>
                                        <Separator/>
                                        <MenuItem Header="破線：粗い" Click="MenuItem_ConnectionCoarseDash_Click"/>
                                        <MenuItem Header="破線：標準" Click="MenuItem_ConnectionNormalDash_Click"/>
                                        <MenuItem Header="破線：細かい" Click="MenuItem_ConnectionFineDash_Click"/>
                                        <Separator/>
                                        <MenuItem Header="色">
                                            <MenuItem Header="黒" Tag="Black" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="青" Tag="#4A90E2" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="灰" Tag="Gray" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="赤" Tag="#D9534F" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="緑" Tag="#5CB85C" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="橙" Tag="#F0AD4E" Click="MenuItem_SetConnectionColor_Click"/>
                                            <MenuItem Header="紫" Tag="#7E57C2" Click="MenuItem_SetConnectionColor_Click"/>
                                        </MenuItem>
                                    </ContextMenu>
                                </Canvas.ContextMenu>

                                <!-- 見た目は変えず、クリック検知だけを広げる透明なヒット領域 -->
                                <Path Data="{Binding LineGeometry}"
                                      Stroke="Transparent"
                                      StrokeThickness="14"
                                      Fill="{x:Null}"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="ConnectionPath_MouseLeftButtonDown"
                                      MouseRightButtonDown="ConnectionPath_MouseRightButtonDown"
                                      Panel.ZIndex="-1" />

                                <Path Data="{Binding LineGeometry}" StrokeThickness="3" Cursor="Hand" MouseLeftButtonDown="ConnectionPath_MouseLeftButtonDown" MouseRightButtonDown="ConnectionPath_MouseRightButtonDown" Panel.ZIndex="0">
                                    <Path.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="文字列表示"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsTextVisible, Mode=OneWay}"
                                                      Click="MenuItem_ConnectionToggleTextVisibility_Click"/>
                                            <Separator/>
                                            <MenuItem Header="矢印を実線にする" Click="MenuItem_ConnectionSolid_Click"/>
                                            <Separator/>
                                            <MenuItem Header="破線：粗い" Click="MenuItem_ConnectionCoarseDash_Click"/>
                                            <MenuItem Header="破線：標準" Click="MenuItem_ConnectionNormalDash_Click"/>
                                            <MenuItem Header="破線：細かい" Click="MenuItem_ConnectionFineDash_Click"/>
                                            <Separator/>
                                            <MenuItem Header="色">
                                                <MenuItem Header="黒" Tag="Black" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="青" Tag="#4A90E2" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="灰" Tag="Gray" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="赤" Tag="#D9534F" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="緑" Tag="#5CB85C" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="橙" Tag="#F0AD4E" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="紫" Tag="#7E57C2" Click="MenuItem_SetConnectionColor_Click"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Path.ContextMenu>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{Binding StrokeColor}" />
                                            <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDashCoarse}" Value="True">
                                                    <Setter Property="StrokeDashArray" Value="8 6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDashNormal}" Value="True">
                                                    <Setter Property="StrokeDashArray" Value="4 4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDashFine}" Value="True">
                                                    <Setter Property="StrokeDashArray" Value="2 2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="StrokeThickness" Value="5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                
                                <Polygon Points="{Binding ArrowPoints}"
                                         Stroke="Transparent"
                                         StrokeThickness="8"
                                         Cursor="Hand"
                                         MouseLeftButtonDown="ConnectionPath_MouseLeftButtonDown"
                                         MouseRightButtonDown="ConnectionPath_MouseRightButtonDown"
                                         Panel.ZIndex="1">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="Fill" Value="{Binding StrokeColor}" />
                                            <Style.Triggers>
                                                <!-- 選択中も Fill は StrokeColor のままにする。
                                                     線の色変更が選択ハイライトで隠れないよう、選択表示は線側の太さで表す。 -->
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>

                                <ItemsControl ItemsSource="{Binding Waypoints}" Panel.ZIndex="10">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" StrokeThickness="2" Cursor="Hand" MouseLeftButtonDown="Waypoint_MouseLeftButtonDown" MouseRightButtonDown="Waypoint_MouseRightButtonDown">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="White" />
                                                        <Setter Property="Stroke" Value="DodgerBlue" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Fill" Value="DodgerBlue"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Fill" Value="#4A90E2" />
                                                                <Setter Property="Stroke" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsJump}" Value="True">
                                                                <Setter Property="Fill" Value="Gold" />
                                                                <Setter Property="Stroke" Value="DarkOrange" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsJump}" Value="True" />
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Fill" Value="DarkOrange" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Grid Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}" Background="White" MinWidth="60" MinHeight="20" Cursor="Hand" MouseLeftButtonDown="ConnectionLabel_PreviewMouseLeftButtonDown" MouseRightButtonDown="ConnectionLabel_MouseRightButtonDown" Panel.ZIndex="5">

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="文字列表示"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsTextVisible, Mode=OneWay}"
                                                      Click="MenuItem_ConnectionToggleTextVisibility_Click"/>
                                            <Separator/>
                                            <MenuItem Header="矢印を実線にする" Click="MenuItem_ConnectionSolid_Click"/>
                                            <Separator/>
                                            <MenuItem Header="破線：粗い" Click="MenuItem_ConnectionCoarseDash_Click"/>
                                            <MenuItem Header="破線：標準" Click="MenuItem_ConnectionNormalDash_Click"/>
                                            <MenuItem Header="破線：細かい" Click="MenuItem_ConnectionFineDash_Click"/>
                                            <Separator/>
                                            <MenuItem Header="色">
                                                <MenuItem Header="黒" Tag="Black" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="青" Tag="#4A90E2" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="灰" Tag="Gray" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="赤" Tag="#D9534F" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="緑" Tag="#5CB85C" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="橙" Tag="#F0AD4E" Click="MenuItem_SetConnectionColor_Click"/>
                                                <MenuItem Header="紫" Tag="#7E57C2" Click="MenuItem_SetConnectionColor_Click"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTextVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PreviewKeyDown="TextBox_PreviewKeyDown" LostFocus="TextBox_LostFocus" IsVisibleChanged="TextBox_IsVisibleChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 分岐点レイヤー。第3段階では Thumb 化してドラッグ移動できるようにする。 -->
                <ItemsControl ItemsSource="{Binding BranchPoints}" Panel.ZIndex="20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Thumb Width="14"
                                   Height="14"
                                   Cursor="SizeAll"
                                   ToolTip="分岐点：ドラッグで移動"
                                   DragStarted="BranchPoint_DragStarted"
                                   DragDelta="BranchPoint_DragDelta">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 親接続線が選択されているとき、または分岐点自体が範囲選択されているときだけ表示する -->
                                            <DataTrigger Binding="{Binding ParentConnection.IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Thumb.Style>
                                <Thumb.RenderTransform>
                                    <TranslateTransform X="-7" Y="-7" />
                                </Thumb.RenderTransform>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Ellipse Fill="White" StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="#4A90E2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="Orange" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="4"
                                                     Height="4"
                                                     Fill="#4A90E2"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Nodes}" Panel.ZIndex="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding Layer}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Thumb DragStarted="Node_DragStarted" DragDelta="Node_DragDelta" PreviewMouseLeftButtonDown="Node_PreviewMouseLeftButtonDown">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Canvas Width="{Binding Width}" Height="{Binding Height}" Background="{x:Null}">
                                            <Path Data="{Binding TailPathLocalData}"
                                                  Fill="{Binding FillColor}"
                                                  Stroke="{Binding StrokeColor}"
                                                  StrokeThickness="2"
                                                  Visibility="{Binding StickySpeechBubbleVisibility}"
                                                  IsHitTestVisible="False"
                                                  Panel.ZIndex="0" />
                                            <Thumb Width="12" Height="12"
                                                   Canvas.Left="{Binding TailHandleLocalLeft}"
                                                   Canvas.Top="{Binding TailHandleLocalTop}"
                                                   Visibility="{Binding TailHandleVisibility}"
                                                   Cursor="SizeAll"
                                                   DragStarted="CalloutTailThumb_DragStarted"
                                                   DragDelta="CalloutTailThumb_DragDelta"
                                                   PreviewMouseLeftButtonDown="CalloutTailThumb_PreviewMouseLeftButtonDown"
                                                   Panel.ZIndex="40">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Fill="White" Stroke="DarkOrange" StrokeThickness="2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand" x:Name="NodeGrid" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Background="Transparent" ContextMenuOpening="NodeGrid_ContextMenuOpening" Panel.ZIndex="10">
                                            
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="シンボルをコピー" Click="MenuItem_CopySymbol_Click" InputGestureText="Ctrl+C"/>
                                                    <MenuItem Header="コピーしたシンボルを貼り付け" Click="MenuItem_PasteSymbol_Click" InputGestureText="Ctrl+V"/>
                                                    <MenuItem Header="このシンボルを複製" Click="MenuItem_DuplicateSymbol_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🔗 URLを開く" Click="MenuItem_OpenUrl_Click" InputGestureText="Ctrl+クリック"/>
                                                    <MenuItem Header="🔗 URLを設定..." Click="MenuItem_SetUrl_Click"/>
                                                    <MenuItem Header="🔗 URLを削除" Click="MenuItem_ClearUrl_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="実線にする" Click="MenuItem_Solid_Click"/>
                                                    <MenuItem Header="点線にする" Click="MenuItem_Dashed_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="枠の色">
                                                        <MenuItem Header="青" Tag="#4A90E2" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="黒" Tag="Black" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="灰" Tag="Gray" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="赤" Tag="#D9534F" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="緑" Tag="#5CB85C" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="橙" Tag="#F0AD4E" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                        <MenuItem Header="紫" Tag="#7E57C2" Click="MenuItem_SetNodeStrokeColor_Click"/>
                                                    </MenuItem>
                                                    <MenuItem Header="塗りつぶしの色">
                                                        <MenuItem Header="白" Tag="White" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="透明" Tag="Transparent" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="薄い青" Tag="#E2F0FF" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="薄い緑" Tag="#E0FFE0" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="薄い黄" Tag="#FFF4A8" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="薄い赤" Tag="#FFE0E0" Click="MenuItem_SetNodeFillColor_Click"/>
                                                        <MenuItem Header="薄い紫" Tag="#EEE6FF" Click="MenuItem_SetNodeFillColor_Click"/>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="付箋に吹き出しを付ける" Click="MenuItem_MakeStickySpeechBubble_Click"/>
                                                    <MenuItem Header="通常の付箋に戻す" Click="MenuItem_MakeStickyNote_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="ファイル形式を表示"
                                                              IsCheckable="True"
                                                              IsChecked="{Binding IsFileFormatVisible, Mode=TwoWay}"
                                                              Click="MenuItem_FileFormatVisible_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="同じシンボルと文字列を検索" Click="MenuItem_SearchSameSymbolText_Click"/>
                                                    <MenuItem Header="検索マークをクリア" Click="MenuItem_ClearSearchMarks_Click"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Ellipse x:Name="ShapeProcess" Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Visibility="Collapsed">
                                                <Ellipse.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Ellipse.Effect>
                                            </Ellipse>
                                            
                                            <Rectangle x:Name="ShapeEntity" Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Visibility="Collapsed">
                                                <Rectangle.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Rectangle.Effect>
                                            </Rectangle>
                                            
                                            <Rectangle x:Name="ShapeFrame" Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="1" Visibility="Collapsed" />
                                            <Rectangle x:Name="ShapeConnectableFrame" Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Visibility="Collapsed" />
                                            
                                            <Border x:Name="ShapeDataStore" Background="{Binding FillColor}" BorderBrush="{Binding StrokeColor}" BorderThickness="0,2,0,2" Visibility="Collapsed">
                                                <Border.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
                                            </Border>

                                            <Viewbox x:Name="ShapeDatabase" Stretch="Fill" Visibility="Collapsed">
                                                <Canvas Width="120" Height="80">
                                                    <Path Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 10,18 C 10,8 110,8 110,18 L 110,62 C 110,72 10,72 10,62 Z"/>
                                                    <Path Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 10,18 C 10,28 110,28 110,18 C 110,8 10,8 10,18 Z"/>
                                                    <Path Fill="Transparent" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 10,62 C 10,72 110,72 110,62"/>
                                                </Canvas>
                                                <Viewbox.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Viewbox.Effect>
                                            </Viewbox>

                                            <Viewbox x:Name="ShapeHorizontalDatabase" Stretch="Fill" Visibility="Collapsed">
                                                <Canvas Width="120" Height="80">
                                                    <Path Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 18,10 C 8,10 8,70 18,70 L 102,70 C 112,70 112,10 102,10 Z"/>
                                                    <Path Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 18,10 C 28,10 28,70 18,70 C 8,70 8,10 18,10 Z"/>
                                                    <Path Fill="Transparent" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 102,10 C 112,10 112,70 102,70"/>
                                                </Canvas>
                                                <Viewbox.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Viewbox.Effect>
                                            </Viewbox>

                                            <Viewbox x:Name="ShapeDocument" Stretch="Fill" Visibility="Collapsed">
                                                <Canvas Width="120" Height="80">
                                                    <!-- Document shape: top corners are aligned to node logical bounds: (0,0) and (120,0). -->
                                                    <Path Fill="{Binding FillColor}" Stroke="{Binding StrokeColor}" StrokeThickness="2" Data="M 0,0 L 120,0 L 120,60 C 96,58 78,62 60,70 C 40,80 20,72 0,68 Z"/>
                                                </Canvas>
                                                <Viewbox.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/></Viewbox.Effect>
                                            </Viewbox>

                                            <Border x:Name="ShapeStickyNote" Background="{Binding FillColor}" BorderBrush="{Binding StrokeColor}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed">
                                                <Border.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
                                            </Border>

                                            <Border x:Name="ShapeStickySpeechBubble" Background="{Binding FillColor}" BorderBrush="{Binding StrokeColor}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed">
                                                <Border.Effect><DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
                                            </Border>

                                            <Border x:Name="ShapeImage" Background="White" BorderBrush="{Binding StrokeColor}" BorderThickness="1" Visibility="Collapsed" ClipToBounds="True">
                                                <Image Source="{Binding ImageSource}" Stretch="Fill" SnapsToDevicePixels="True" />
                                            </Border>
                                            
                                            <Border x:Name="SelectionHighlight" BorderBrush="Orange" BorderThickness="3" Visibility="Collapsed" Margin="-3" CornerRadius="5"/>
                                            
                                            <Grid Margin="5">
                                                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" x:Name="LabelText" TextWrapping="Wrap" TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <TextBox x:Name="EditTextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PreviewKeyDown="TextBox_PreviewKeyDown" LostFocus="TextBox_LostFocus" IsVisibleChanged="TextBox_IsVisibleChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                            

                                            <!-- シンボル外側の左上に表示する小さなファイル形式入力欄（例: .txt, .csv, .json） -->
                                            <TextBox x:Name="FileFormatBox"
                                                     Text="{Binding FileFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     Width="46"
                                                     Height="18"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Margin="0,-22,0,0"
                                                     Padding="2,0"
                                                     FontSize="10"
                                                     FontWeight="Bold"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Background="#FFFFF4"
                                                     BorderBrush="#777"
                                                     BorderThickness="1"
                                                     Foreground="#333"
                                                     ToolTip="ファイル形式（例: .txt, .csv, .json）"
                                                     PreviewKeyDown="FileFormatTextBox_PreviewKeyDown"
                                                     LostFocus="FileFormatTextBox_LostFocus"
                                                     Panel.ZIndex="30"
                                                     Visibility="Collapsed" />
                                            <Thumb x:Name="ResizeThumb" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" Visibility="Collapsed" Panel.ZIndex="60">
                                                <Thumb.Template>
                                                    <ControlTemplate>
                                                        <Grid Background="Transparent">
                                                            <Path Data="M 0 15 L 15 0 L 15 15 Z" Fill="Gray" Opacity="0.5"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                        </Canvas>
                                        
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Process">
                                                <Setter TargetName="ShapeProcess" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Entity">
                                                <Setter TargetName="ShapeEntity" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="DashEntity">
                                                <Setter TargetName="ShapeEntity" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ShapeEntity" Property="StrokeDashArray" Value="3 2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="CategoryFrame">
                                                <Setter TargetName="ShapeFrame" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="LabelText" Property="VerticalAlignment" Value="Top"/>
                                                <Setter TargetName="LabelText" Property="HorizontalAlignment" Value="Left"/>
                                                <Setter TargetName="NodeGrid" Property="Panel.ZIndex" Value="-10"/>
                                                <Setter TargetName="NodeGrid" Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="ConnectableFrame">
                                                <Setter TargetName="ShapeConnectableFrame" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="LabelText" Property="VerticalAlignment" Value="Top"/>
                                                <Setter TargetName="LabelText" Property="HorizontalAlignment" Value="Left"/>
                                                <Setter TargetName="NodeGrid" Property="Panel.ZIndex" Value="-5"/>
                                                <Setter TargetName="NodeGrid" Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="DataStore">
                                                <Setter TargetName="ShapeDataStore" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Database">
                                                <Setter TargetName="ShapeDatabase" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="HorizontalDatabase">
                                                <Setter TargetName="ShapeHorizontalDatabase" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Document">
                                                <Setter TargetName="ShapeDocument" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="StickyNote">
                                                <Setter TargetName="ShapeStickyNote" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="LabelText" Property="FontWeight" Value="Normal" />
                                                <Setter TargetName="LabelText" Property="HorizontalAlignment" Value="Left" />
                                                <Setter TargetName="LabelText" Property="VerticalAlignment" Value="Top" />
                                                <Setter TargetName="LabelText" Property="TextAlignment" Value="Left" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="StickySpeechBubble">
                                                <Setter TargetName="ShapeStickySpeechBubble" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="LabelText" Property="FontWeight" Value="Normal" />
                                                <Setter TargetName="LabelText" Property="HorizontalAlignment" Value="Left" />
                                                <Setter TargetName="LabelText" Property="VerticalAlignment" Value="Top" />
                                                <Setter TargetName="LabelText" Property="TextAlignment" Value="Left" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="ImageNode">
                                                <Setter TargetName="ShapeImage" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="EditTextBox" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>

                                            <!-- 右クリックメニューの「ファイル形式を表示」がONのときだけ表示 -->
                                            <DataTrigger Binding="{Binding IsFileFormatVisible}" Value="True">
                                                <Setter TargetName="FileFormatBox" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelectionHighlight" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ResizeThumb" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            
                                            <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                <Setter TargetName="ShapeFrame" Property="StrokeDashArray" Value="4 4" />
                                                <Setter TargetName="ShapeConnectableFrame" Property="StrokeDashArray" Value="4 4" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
